{
  "name": "fyodor-trading-terminal-lite",
  "version": "1.0.0",
  "description": "MT5 charts, raw economic calendar Inspector, upcoming Alert and Activity",
  "private": true,
  "scripts": {
    "analyst": "bridge\\.venv\\Scripts\\python.exe \"Market Analyst Workflow\\tools\\market_data.py\"",
    "dev:ui": "pnpm --dir frontend dev",
    "dev:bridge": "bridge\\.venv\\Scripts\\python.exe bridge\\run_dev.py",
    "dev:storage": "bridge\\.venv\\Scripts\\python.exe storage\\run.py serve",
    "storage:import": "bridge\\.venv\\Scripts\\python.exe storage\\run.py import",
    "storage:status": "bridge\\.venv\\Scripts\\python.exe storage\\run.py status",
    "install:frontend": "pnpm --dir frontend install --frozen-lockfile",
    "clean-ports": "pnpm --dir frontend run clean-ports",
    "dev:all": "pnpm --dir frontend run dev:all",
    "test:frontend": "pnpm --dir frontend test",
    "test:storage": "bridge\\.venv\\Scripts\\python.exe -m unittest discover storage/tests -v",
    "test": "pnpm run test:frontend && pnpm run test:storage",
    "lint": "pnpm --dir frontend lint",
    "check:repo": "pnpm --dir frontend run check:repo",
    "build": "pnpm --dir frontend build",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "storage:backup": "bridge\\.venv\\Scripts\\python.exe storage\\run.py backup",
    "storage:restore": "bridge\\.venv\\Scripts\\python.exe storage\\run.py restore"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
